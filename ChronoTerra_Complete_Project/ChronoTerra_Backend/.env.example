CHRONOTERRA_MAX_UPLOAD_MB=150
CHRONOTERRA_MAX_REQUEST_UPLOAD_MB=256
CHRONOTERRA_SESSION_RETENTION_HOURS=24
CHRONOTERRA_MAX_IMAGE_PIXELS=40000000
CHRONOTERRA_SAMPLE_MAX_DIM=512
CHRONOTERRA_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Optional checkpoint overrides; defaults are under prediction_module/outputs/models/.
# CHRONOTERRA_URBAN_CHECKPOINT=prediction_module/outputs/models/oscd_siamese_v2/best.pt
# CHRONOTERRA_FLOOD_CHECKPOINT=prediction_module/outputs/models/sen1floods11_sar_unet_v1/best.pt
# CHRONOTERRA_DAMAGE_CHECKPOINT=prediction_module/outputs/models/xbd_damage_unet_v1/best.pt

# Strong optional HMAC signing secret for artifact download links. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# If left blank, the process generates an ephemeral secret; links stop working after restart.
CHRONOTERRA_ARTIFACT_SIGNING_SECRET=
