# Optional: backend base URL (Vite frontend). Default is the local FastAPI server.
VITE_API_BASE_URL=http://127.0.0.1:8000/api

# Optional: Google Maps JavaScript API key with Maps JavaScript API and Places API (New) enabled.
# Restrict the key to localhost during development and to your domain in production.
VITE_GOOGLE_MAPS_API_KEY=
